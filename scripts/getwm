if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    id=$(xprop -root -notype _NET_SUPPORTING_WM_CHECK 2>/dev/null)
    id=${id##* }
    wm=$(xprop -id "$id" -notype -len 100 -f _NET_WM_NAME 8t 2>/dev/null |
        grep '^_NET_WM_NAME' | cut -d\" -f 2)
    [ -z "$wm" ] && wm="unknown"
else
    wm="tty"
fi

echo $wm
