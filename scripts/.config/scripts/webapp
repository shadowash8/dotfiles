#!/bin/bash

# 1. Check if the URL argument is missing
if [ -z "$1" ]; then
    echo "Error: Please provide a URL."
    echo "Usage: $0 https://example.com"
    exit 1
fi

URL="$1"

# This ensures it opens in a completely fresh, isolated window
DIR_HASH=$(echo -n "$URL" | md5sum | cut -d' ' -f1)

# 3. Launch qutebrowser with the "App Mode" settings
qutebrowser \
    --target window \
    -s tabs.show never \
    -s statusbar.show never \
    ':tab-only' \
    ':bind o nop' \
    ':bind O nop' \
    ':bind <Ctrl-t> nop' \
    ':bind <Ctrl-n> nop' \
    "$URL"
