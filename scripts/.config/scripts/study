#!/bin/bash

# --- Configuration ---
BROWSER="firefox:fe2njbzs.default-release"
CACHE_DIR="$HOME/.cache/study"
DB_FILE="$CACHE_DIR/seen_streams.txt"
MENU_DATA="$CACHE_DIR/menu_data.txt"
LIMIT_PER_CHANNEL=15

CHANNELS=(
    "https://www.youtube.com/@jamesvinhscholz/streams"
    "https://www.youtube.com/@jkwonnn/streams"
    "https://www.youtube.com/@i_kkoh/streams"
    "https://www.youtube.com/@tokisuno/streams"
)

mkdir -p "$CACHE_DIR"
touch "$DB_FILE" "$MENU_DATA"

echo "Checking for new study sessions..."

for channel in "${CHANNELS[@]}"; do
    echo "Scanning: $channel"
    
    # Use the logic that worked: simple ID | Title print
    yt-dlp --cookies-from-browser "$BROWSER" \
        --flat-playlist \
        --playlist-items "1:$LIMIT_PER_CHANNEL" \
        --match-title "(?i)study" \
        --print "%(id)s | %(title)s" \
        "$channel" 2>/dev/null | while read -r line; do
            
            # Extract ID (everything before the first space)
            v_id=$(echo "$line" | cut -d' ' -f1)
            
            # Check if we've seen this ID
            if ! grep -q "$v_id" "$DB_FILE"; then
                echo "  [NEW] $line"
                echo "$v_id" >> "$DB_FILE"
                
                # Prepend to menu data (ID | Title format)
                printf "%s\n" "$line" | cat - "$MENU_DATA" > "$MENU_DATA.tmp" && mv "$MENU_DATA.tmp" "$MENU_DATA"
            fi
        done
done

echo "Launching Menu..."

if [ ! -s "$MENU_DATA" ]; then
    echo "No streams found. If you want to re-scan, run: rm $DB_FILE $MENU_DATA"
    exit 1
fi

# FZF Menu using the ID | Title format
selected=$(fzf --prompt="Select Study Stream > " \
               --reverse \
               --border \
               --with-nth="3.." \
               --preview "
                   id=\$(echo {} | cut -d' ' -f1)
                   thumb_path=\"$CACHE_DIR/\$id.jpg\"
                   [ ! -f \"\$thumb_path\" ] && curl -s -o \"\$thumb_path\" \"https://img.youtube.com/vi/\$id/hqdefault.jpg\" 2>/dev/null
                   chafa --size=80x40 \"\$thumb_path\" 2>/dev/null
               " --preview-window=right:60%:wrap < "$MENU_DATA")

if [ -n "$selected" ]; then
    v_id=$(echo "$selected" | cut -d' ' -f1)
    clear
    echo "Opening Stream: $v_id"
    mpv "https://www.youtube.com/watch?v=$v_id"
    
    # Mark as watched
    yt-dlp --cookies-from-browser "$BROWSER" --mark-watched --skip-download "https://www.youtube.com/watch?v=$v_id" 2>/dev/null
fi
