#!/usr/bin/env bash

TMP=$(mktemp /tmp/shot.XXXXXX.png)
SAVEDIR="$HOME/pictures/screenshots/"
mkdir -p "$SAVEDIR"

show_help() {
  cat <<EOF2
Usage: $(basename "$0") [OPTION]

Options:
  clip      Capture region → clipboard only
  color     Color picker → clipboard
  full      Full screen → save to ~/Pictures/Screenshots
  ocr       Capture region → OCR text → clipboard
  (none)    Capture region → save to ~/Pictures/Screenshots (default)
EOF2
# window    Active window → save to ~/Pictures/Screenshots
}

capture_clipboard_only() {
  grim -g "$(slurp)" "$TMP" &&
    wl-copy <"$TMP" &&
    notify-send "Clipboard" "Region copied to clipboard" -i "$TMP"
}

colorpicker() {
  COLOR=$(hyprpicker -a) &&
    notify-send "Color Picker" "Copied $COLOR to clipboard" -i camera-photo
}

capture_full() {
  FILE="$SAVEDIR/$(date +%Y-%m-%d_%H-%M-%S).png" &&
    grim "$FILE" &&
    notify-send "Screenshot" "Saved to Pictures/Screenshots" -i "$FILE"
}

capture_window() {
  FILE="$SAVEDIR/$(date +%Y-%m-%d_%H-%M-%S).png" &&
    GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"') &&
    grim -g "$GEOM" "$FILE" &&
    notify-send "Screenshot" "Window saved to Pictures/Screenshots" -i "$FILE"
}

capture_selection() {
  FILE="$SAVEDIR/$(date +%Y-%m-%d_%H-%M-%S).png" &&
    grim -g "$(slurp)" "$FILE" &&
    notify-send "Screenshot" "Saved to Pictures/Screenshots" -i "$FILE"
}

ocr() {
  grim -g "$(slurp)" "$TMP" || return 1
  tesseract "$TMP" - | tr -d '\f' | wl-copy
  notify-send 'OCR' 'Text copied to clipboard' -i "$TMP"
  rm "$TMP"
}

main() {
  case "${1:-}" in
  -h | --help) show_help ;;
  clip) capture_clipboard_only ;;
  color*) colorpicker ;;
  full) capture_full ;;
  window) capture_window ;;
  ocr) ocr ;;
  *) capture_selection ;;
  esac
}

main "$@"
