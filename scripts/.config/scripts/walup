#!/bin/bash

# update bg
feh --bg-fill $(cat ~/.cache/wal/wal) &
swww img $(cat ~/.cache/wal/wal) --transition-type grow --transition-pos 0.85,0.85 --transition-fps 60 &

# update xrdb
xrdb -load ~/.Xresources

# update emacs colors
emacsclient -e '(my/reload-xresources-theme)' &

# update firefox colors
pywalfox update &

# update kitty colors
pkill -SIGUSR1 kitty

# update dunst colors
pkill dunst &
dunst &
disown

# update qute-reload colors
qute-reload &

# update cosmic colors
cosmic-settings appearance import ~/.cache/wal/colors-cosmic.ron
