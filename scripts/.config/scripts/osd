#!/bin/bash

# Dependencies: brightnessctl, wireplumber, libnotify, slock

# Function to handle Brightness
brightness() {
    # Get current value BEFORE changing it (e.g., 5)
    local current_val=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
    
    # Check if we are trying to decrease ($2 contains '-')
    if [[ "$2" == *"-"* ]]; then
        # Extract the number from the argument (e.g., "5%-" becomes "5")
        local step=$(echo "$2" | tr -d '%-')
        # Calculate what the new value WOULD be
        local target=$((current_val - step))
        
        # SAFETY CHECK: If the target drops below 1%, force it to lock at 1%
        if [ "$target" -lt 1 ]; then
            brightnessctl set 1% > /dev/null
            current_val=1
            
            # Send notification and exit function early without dropping to 0
            notify-send -h string:x-dunst-stack-tag:bri -h int:value:"$current_val" "Brightness: $current_val%"
            return
        fi
    fi

    # If it's safe to change (or if we are increasing), execute standard change
    brightnessctl set "$2" > /dev/null
    local final_val=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
    
    notify-send -h string:x-dunst-stack-tag:bri \
                -h int:value:"$final_val" \
                "Brightness: $final_val%"
}

# Function to handle Volume
volume() {
    if [ "$2" == "toggle" ]; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    else
        wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
    fi
        
    # Update dwmblocks (Signal 4)
    pkill -RTMIN+4 dwmblocks 2>/dev/null
        
    # Get volume info
    vol_raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    is_muted=$(echo "$vol_raw" | grep -o "MUTED")
        
    if [ -n "$is_muted" ]; then
        notify-send -u low -h string:x-dunst-stack-tag:vol "Volume: Muted"
    else
        # Convert 0.50 to 50 and ensure it's an integer for Dunst
        val=$(echo "$vol_raw" | awk '{printf "%.0f", $2 * 100}')
        notify-send -u low -h string:x-dunst-stack-tag:vol -h int:value:"$val" "Volume: ${val}%"
    fi
}

# Main Case Statement
case "$1" in
    brightness)
        brightness "$1" "$2"
        ;;
    volume)
        volume "$1" "$2"
        ;;
    lock)
        slock &
        ;;
    *)
        echo "Usage: $0 {brightness [+/-value]|volume [+/-value|toggle]|lock}"
        ;;
esac
