#!/bin/bash

# 1. Get the list of all themes from cwal and extract just the theme names
themes=$(cwal --list-themes | grep '\.cwal$' | awk '{print $1}' | sed 's/\.cwal$//')

# 2. Pipe that list into dmenu
selected_theme=$(echo "$themes" | dmenu -p "Select Theme:" -l 20)

# 3. If a theme was selected, apply it and run your -o script
if [ -n "$selected_theme" ]; then
    cwal --theme "$selected_theme" --script "walup"
    notify-send "Cwal" "Theme '$selected_theme' applied."
fi
