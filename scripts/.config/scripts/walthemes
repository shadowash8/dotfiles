#!/bin/bash

# 1. Get the list of all themes from ashwal and extract just the theme names
themes=$(ashwal --list-themes | grep '\.ashwal$' | awk '{print $1}' | sed 's/\.ashwal$//')

# 2. Pipe that list into rofi
selected_theme=$(echo "$themes" | rofi -dmenu -p "Select Theme:" -l 20)

# 3. If a theme was selected, apply it and run your -o script
if [ -n "$selected_theme" ]; then
    cwal --theme "$selected_theme" --script "walup"
    notify-send "ashwal" "Theme '$selected_theme' applied."
fi
