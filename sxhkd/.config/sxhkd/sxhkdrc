# --- Launchers ---

# Terminal (st)
super + Return
    st 

super + space
    rofi -show drun

# Browser
super + t
    qbpm choose 

# File Manager 
super + e
    pcmanfm

# Emacs Client
super + w
    emacsclient -c -a emacs

# Connect Phone
super + p
    connect

# Music
super + m
    kitty rmpc

# Web Search
super + ctrl + r
    websearch

# Notes
super + shift + space
    notes

# Wallpaper Menu
super + ctrl + space
    walmenu

super + Escape
    pkill -USR1 sxhkd && notify-send "sxhkd" "Configuration reloaded"


# Volume
XF86Audio{Raise,Lower}Volume
    osd volume {5%+,5%-} && pkill -SIGRTMIN+10 i3blocks

XF86AudioMute
    osd volume toggle && pkill -SIGRTMIN+10 i3blocks

# Brightness (Assuming you want a brightness block too)
XF86MonBrightness{Up,Down}
    osd brightness {+5%,-5%} && pkill -SIGRTMIN+11 i3blocks
