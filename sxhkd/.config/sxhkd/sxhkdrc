# --- Launchers ---

# Terminal (st)
super + Return
    kitty 

# Browser
super + b
    qbpm choose 

# File Manager 
super + f
    pcmanfm

# Emacs Client
super + w
    emacsclient -c -a emacs

# Connect Phone
super + p
    connect

# Music
super + h
    kitty rmpc

# Web Search
super + ctrl + r
    websearch

# Notes
super + shift + space
    notes

# Wallpaper Menu
super + ctrl + space
    walmenu

super + Escape
    pkill -USR1 sxhkd && notify-send "sxhkd" "Configuration reloaded"

