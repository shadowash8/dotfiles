# --- Launchers ---

# Terminal (st)
super + Return
    st 

super + space
    rofi -show drun

# Browser
super + t
    helium-browser 

# File Manager 
super + e
    pcmanfm

# Emacs Client
super + w
    emacsclient -c -a emacs

# Connect Phone
super + p
    connect

# Music
super + m
    kitty rmpc

# Web Search
super + ctrl + r
    websearch

# Notes
super + shift + space
    notes

# Wallpaper Menu
super + ctrl + space
    walmenu

super + Escape
    pkill -USR1 sxhkd && notify-send "sxhkd" "Configuration reloaded"

