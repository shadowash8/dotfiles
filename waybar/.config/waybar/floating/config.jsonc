{
  "layer": "top",
  "position": "top",
  "height": 25,
  "width": 720,
  "margin-top": 10,
  "spacing": 4,
  "modules-left": [
    "ext/workspaces",  
    "network",
    "custom/vpn"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "battery",
    "pulseaudio"
  ],
"ext/workspaces": {
	"format": "{name}: {icon}",
	"on-click": "activate",
	"format-icons": {
		"Workspace 1": "",
		"Workspace 2": "",
		"Workspace 3": "",
		"Workspace 4": "",
		"active": "",
		"default": ""
	},
	"sort-by-id": true
},
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  },
  "network": {
    "format-wifi": "[W] {signalStrength}%",
    "format-ethernet": "[E]",
    "format-disconnected": "no",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname} (Wired)",
    "on-click": "$TERMINAL impala"
  },
  "custom/vpn": {
    "format": "[V]",
    "exec": "echo '{\"class\": \"connected\"}'",
    "exec-if": "test -d /proc/sys/net/ipv4/conf/protonvpn",
    "return-type": "json",
    "on-click": "pkexec wg-quick up protonvpn",
    "on-click-right": "pkexec wg-quick down protonvpn",
    "interval": 5
  },
  "pulseaudio": {
    "scroll-step": 2,
    "format": "{volume}% [V]",
    "format-muted": "[M]",
    "format-bluetooth": "[V]BT {volume}%",
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "[B] {capacity}%",
    "format-charging": "[B]! {capacity}%",
    "format-plugged": "[B]! {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  }
}
