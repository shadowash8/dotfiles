{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 8,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/user-menu",
    "group/ashrwm-tags",
    "custom/ashrwm-window"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "group/expand",
    "power-profiles-daemon",
    "backlight",
    "pulseaudio",
    "battery",
    "network",
    "clock"
  ],
  "custom/user-menu": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/res/user_menu.xml",
    "menu-actions": {
      "user": "foot -H fastfetch",
      "home": "thunar $HOME",
      "documents": "thunar $HOME/documents",
      "pictures": "thunar $HOME/pictures",
      "videos": "thunar $HOME/videos",
      "downloads": "thunar $HOME/downlaods",
      "music": "thunar $HOME/moosic",
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "lock": "hyprlock",
      "suspend": "systemctl suspend"
    }
  },
"group/ashrwm-tags": {
    "orientation": "horizontal",
    "modules": [
        "custom/tag-1", "custom/tag-2", "custom/tag-3",
        "custom/tag-4", "custom/tag-5", "custom/tag-6",
        "custom/tag-7", "custom/tag-8", "custom/tag-9"
    ]
},
"custom/tag-1": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 1", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 1)'" },
"custom/tag-2": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 2", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 2)'" },
"custom/tag-3": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 3", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 3)'" },
"custom/tag-4": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 4", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 4)'" },
"custom/tag-5": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 5", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 5)'" },
"custom/tag-6": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 6", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 6)'" },
"custom/tag-7": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 7", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 7)'" },
"custom/tag-8": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 8", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 8)'" },
"custom/tag-9": { "exec": "/home/ashwin/downloads/ashrwm-waybar-tags.janet 9", "return-type": "json", "on-click": "ashrwm-msg '(action/focus-tag 9)'" },
"custom/ashrwm-window": {
    "exec": "/home/ashwin/downloads/ashrwm-waybar-window.janet",
    "return-type": "json",
    "escape": true,
    "max-length": 60
},

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "clock": {
    "format": "{:%a, %b %d, %I:%M %p}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "actions": {
      "on-click-right": "shift_down",
      "on-click": "shift_up"
    }
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "",
    "format-disconnected": "",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-disconnected": "Error",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) 󰤨",
    "tooltip-format-ethernet": "{ifname} 🖧 ",
    // "on-click": "rofi -show wifi -modi 'wifi:iwdrofimenu'"
    "on-click": "$TERMINAL impala"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "BT-off",
    "format-disabled": "󰂲",
    "format-connected-battery": "󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%"
  },
  "battery": {
    "interval": 1,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄  {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "󰁻",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂",
      "󰁹"
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " ",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "󱩎",
      "󱩏",
      "󱩐",
      "󱩑",
      "󱩒",
      "󱩓",
      "󱩔",
      "󱩕",
      "󱩖",
      "󰛨"
    ]
  },
  "custom/expand": {
    "format": "",
    "tooltip": false
  },
  "custom/endpoint": {
    "format": " ",
    "tooltip": false
  },
  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-to-left": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/expand",
      "tray",
      "custom/endpoint"
    ]
  },
  "tray": {
    "icon-size": 14,
    "spacing": 10
  },
  "custom/org-clock": {
    "exec": "~/.config/scripts/org-clock-task",
    "interval": 60,
    "return-type": "text",
    "tooltip": false
  }
}
