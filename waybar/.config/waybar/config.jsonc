{
  "layer": "top",
  "position": "top",
  "height": 26,
  "width": 720,
  "margin-top": 10,
  "spacing": 4,
  "modules-left": [
    "network",
    "custom/protonvpn"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%c}"
  },
  "network": {
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": "wifi: {signalStrength}%",
    "format-ethernet": "[E]",
    "format-disconnected": "no",
    "tooltip-format": "󰊗 {ifname} via {gwaddr}",
    "tooltip-format-wifi": "  {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname}",
    "on-click": "rofi -show wifi -modi 'wifi:iwdrofimenu'"
  },
  "custom/protonvpn": {
    "format": "[V]",
    "exec": "echo '{\"class\": \"connected\"}'",
    "exec-if": "test -d /proc/sys/net/ipv4/conf/protonvpn/",
    "return-type": "json",
    "interval": 5
  },
  "pulseaudio": {
    "scroll-step": 2,
    "format": "volume: {volume}%",
    "format-muted": "mute",
    "format-bluetooth": "[V]BT {volume}%",
    "on-click": "pavucontrol"
  }
}
