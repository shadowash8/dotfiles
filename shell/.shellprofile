# Vars
export LANG=en_US.UTF-8
export EDITOR="nvim"
export PATH="$HOME/.local/bin:$HOME/.config/scripts:$PATH"
export GOGC=25
export TERMINAL=kitty

# Alias
alias vi="nvim"
alias vim="nvim"
alias zshconf="vi ~/.zshrc"
alias zshref="source ~/.zshrc"
alias ls='eza'
alias ll='eza -la'
alias g="git"
alias cls="clear"
alias lg="lazygit"
alias lj="lazyjournal"
alias em='emacsclient -c -a "emacs"'
alias get="curl -O"
alias clip="xclip -selection clipboard"

alias sv="systemctl"

alias dwmgen="cd ~/.ashdwm/dwm/ && sudo make clean install"
alias dwlgen="cd ~/.ashdwl/dwl/ && sudo make clean install"
alias pdry="patch --dry-run -p1 <"
alias prun="patch -p1 <"
alias sx="startx ~/.xinitrc"
alias ws="wayback-session"
alias sus="systemctl suspend"
alias wifi="rofi -show wifi -modi 'wifi:iwdrofimenu'"
