# Vars
export LANG=en_US.UTF-8
export PATH="$HOME/.local/bin:$HOME/.config/scripts:$HOME/.wakatime:$PATH"
export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
export TERMINAL=foot
export EDITOR="emacsclient -n -c emacs"
export VISUAL="emacsclient -n -c emacs"
export BROWSER="helium-browser"
#export XKB_DEFAULT_LAYOUT=us
#export XKB_DEFAULT_VARIANT=colemak_dh
export XMODIFIERS=@im=fcitx
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx

# Alias
alias vi="nvim"
alias vim="nvim"
alias zshconf="$EDITOR ~/.zshrc"
alias zshref="source ~/.zshrc"
alias shellconf="$EDITOR ~/.shellprofile"
alias ls='eza --git-ignore'
alias ll='eza -la'
alias g="git"
alias cls="clear"
alias lg="lazygit"
alias get="wget"
alias open="xdg-open"
alias clip="wl-copy"

alias sv="systemctl"
alias sus="systemctl suspend"
alias music="systemctl --user start {mpd,mpd-mpris}"
alias musicoff="systemctl --user stop {mpd,mpd-mpris}"
alias hddsus="sudo hdparm -y /dev/sda"

alias dwmgen="cd ~/.ashdwm/dwm/ && sudo make clean install"
alias dwlgen="cd ~/.ashdwl/dwl/ && sudo make clean install"
alias neugen="cd ~/code/neuwm/ && make clean && make && sudo make install"
alias sx="startx ~/.xinitrc"
alias wifi='rofi -show wifi -modi "wifi:iwdrofimenu"'
alias vpnup="sudo wg-quick up protonvpn"
alias vpndown="sudo wg-quick down protonvpn"

# functions
em() {
    emacsclient -c -a "emacs" "$@" & disown
}
et() {
	emacsclient -t -a "emacs" "$@"
}
define() {
    curl -s "dict://dict.org/d:$1" | bat --language=md --style=grid,numbers
}

pdry() { patch --dry-run -p1 < "$1"; }
prun() { patch -p1 < "$1"; }

ashrwmreload() {
	ashrwm & disown
}

ashrwmgen() {
	cd ~/code/ashrwm
	zig build
	sudo rm /usr/local/bin/ashrwm
	sudo cp zig-out/bin/ashrwm /usr/local/bin
}
