include "~/.cache/ashwal/colors-sway"

set $mod Mod4

# Appearance
default_border pixel 2
default_floating_border pixel 2

# Autostart
exec_always --no-startup-id sh -c 'feh --bg-fill "$(cat ~/.cache/ashwal/ashwal)"'
exec --no-startup-id picom
exec --no-startup-id dunst
exec --no-startup-id setxkbmap us -variant colemak_dh
exec --no-startup-id xrdb -override ~/.Xresources
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Settings
floating_modifier $mod
tiling_drag modifier titlebar

# Bindings
bindsym $mod+q kill
bindsym $mod+Return exec st
bindsym $mod+w exec emacsclient -n -c emacs
bindsym $mod+b exec helium-browser
bindsym $mod+space exec rofi -show drun

# Focus 
bindsym $mod+m focus left
bindsym $mod+n focus down
bindsym $mod+e focus up
bindsym $mod+i focus right

# Move 
bindsym $mod+Shift+m move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+e move up
bindsym $mod+Shift+i move right

# Arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layouts
bindsym $mod+h split h
bindsym $mod+Shift+h split v
bindsym $mod+a fullscreen toggle
bindsym $mod+x layout stacking
bindsym $mod+z layout tabbed
bindsym $mod+c layout toggle split
bindsym $mod+g floating toggle
bindsym $mod+Control+h focus mode_toggle

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# System 
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Volume Keys
bindsym XF86AudioRaiseVolume exec --no-startup-id osd volume 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id osd volume 5%-
bindsym XF86AudioMute        exec --no-startup-id osd volume toggle

# Brightness Keys
bindsym XF86MonBrightnessUp   exec --no-startup-id osd brightness 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id osd brightness 5%-

# Resize Mode
mode "resize" {
    bindsym m resize shrink width 10 px or 10 ppt
    bindsym n resize grow height 10 px or 10 ppt
    bindsym e resize shrink height 10 px or 10 ppt
    bindsym i resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Bar Configuration
bar {
    status_command i3status
    position bottom
    
    # Matching your Waybar height (approx) and font
    font pango:sans 10

    colors {
        background #000000
        statusline #c1c1c1
        separator  #f8f7f2

        #                      BORDER      BG          TEXT
        focused_workspace     #5f8787     #5f8787     #00000
        active_workspace      #333333     #333333     #c1c1c1
        inactive_workspace    #000000     #000000     #888888
        urgent_workspace      #79241f     #79241f     #c1c1c1
    }
}
